# Base URL of the Eventor API (NestJS). The API runs on :3000, the dashboard on :3001.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Auth guard for the (app) routes (module 1). On unless set to false.
NEXT_PUBLIC_AUTH_ENABLED=true

# Optional: build into another folder while `next dev` is running (e.g. .next-build)
# NEXT_DIST_DIR=.next-build
